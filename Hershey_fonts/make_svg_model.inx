<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

  <name>Glyph Grid Model</name>
  <id>org.inkscape.effect.glyph_grid_model</id>

  <param name="font-family" type="string" gui-text="Police">Arial</param>

  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Glyphs"/>
    </effects-menu>
  </effect>

  <script>
    <command location="inx" interpreter="python">make_svg_model.py</command>
  </script>

</inkscape-extension>
